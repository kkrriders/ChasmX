# ChasmX Docker Environment Configuration
# Copy this file to .env and update with your values
#
# Note: MongoDB Atlas connection string should be configured in apps/backend/.env
# This file is for Docker-specific settings only

# ======================
# Redis Configuration
# ======================
REDIS_PASSWORD=your-secure-redis-password

# ======================
# Application Settings
# ======================
# Development or production
ENVIRONMENT=development
