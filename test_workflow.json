{
  "name": "Test New Node Types Workflow",
  "description": "Testing filter, transformer, condition, and loop nodes",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "position": {"x": 100, "y": 100},
      "config": {}
    },
    {
      "id": "filter1",
      "type": "filter",
      "position": {"x": 300, "y": 100},
      "config": {
        "filter_type": "condition",
        "condition": "{{user_age}} >= 18"
      }
    },
    {
      "id": "transform1",
      "type": "transformer",
      "position": {"x": 500, "y": 100},
      "config": {
        "transform_type": "map",
        "field_mappings": {
          "full_name": "name",
          "email_address": "email",
          "user_age": "age"
        }
      }
    },
    {
      "id": "condition1",
      "type": "condition",
      "position": {"x": 700, "y": 100},
      "config": {
        "condition_type": "simple",
        "condition": "{{user_age}} > 65",
        "true_path": "senior_processing",
        "false_path": "adult_processing"
      }
    },
    {
      "id": "loop1",
      "type": "loop",
      "position": {"x": 900, "y": 100},
      "config": {
        "loop_type": "range",
        "start": 1,
        "end": 4,
        "step": 1,
        "counter_name": "iteration"
      }
    },
    {
      "id": "end",
      "type": "end",
      "position": {"x": 1100, "y": 100},
      "config": {}
    }
  ],
  "edges": [
    {"from": "start", "to": "filter1"},
    {"from": "filter1", "to": "transform1"},
    {"from": "transform1", "to": "condition1"},
    {"from": "condition1", "to": "loop1"},
    {"from": "loop1", "to": "end"}
  ],
  "variables": [],
  "metadata": {
    "description": "Test workflow for new node types",
    "author": "System Test",
    "version": "1.0"
  }
}